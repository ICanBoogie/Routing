{
    "name": "icanboogie/routing",
    "type": "library",
    "description": "Request routing",
    "keywords": [
        "routing",
        "controller"
    ],
    "homepage": "https://icanboogie.org/",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Olivier Laviale",
            "email": "olivier.laviale@gmail.com",
            "homepage": "https://olvlvl.com/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ICanBoogie/Routing/issues",
        "source": "https://github.com/ICanBoogie/Routing"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "olvlvl/composer-attribute-collector": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "prefer-dist": true,
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "icanboogie/http": "^7.0"
    },
    "require-dev": {
        "olvlvl/composer-attribute-collector": "^3.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "psr/container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ICanBoogie\\Routing\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\ICanBoogie\\Routing\\": "tests/"
        },
        "files": [
            "vendor/attributes.php"
        ]
    },
    "extra": {
        "composer-attribute-collector": {
            "include": [
                "tests/Discovery"
            ]
        }
    }
}
